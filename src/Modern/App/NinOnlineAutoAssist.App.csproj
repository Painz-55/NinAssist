<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>NinOnlineAutoAssist.App</AssemblyName>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Version>1.2.0</Version>
    <LangVersion>12.0</LangVersion>
    <Nullable>annotations</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <DefineConstants Condition="'$(LoginPreviewBuild)' == 'true'">$(DefineConstants);LOGIN_PREVIEW</DefineConstants>
    <UpdateRepositoryUrl Condition="'$(UpdateRepositoryUrl)' == ''">https://github.com/Painz-55/NinAssist</UpdateRepositoryUrl>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="UpdateRepositoryUrl" Value="$(UpdateRepositoryUrl)" />
    <PackageReference Include="Velopack" Version="1.2.161" />
    <ProjectReference Include="..\..\NinOnlineAutoAssist.Core\NinOnlineAutoAssist.Core.csproj" />
    <ProjectReference Include="..\Live\ModernLive.csproj" />
    <ProjectReference Include="..\Diagnostics\ModernDiagnostics.csproj" />
    <Content Include="..\..\..\compatibility\package-profiles.json" Link="compatibility\profiles.json" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\..\compatibility\package-profiles.json.sig" Link="compatibility\profiles.json.sig" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
